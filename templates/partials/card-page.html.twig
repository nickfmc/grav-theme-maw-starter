{# A page rendered as a card. Vars: item (page), show_image, show_date (both default to true) #}
{% import 'macros/ui.html.twig' as ui %}
{# Not |default(true): Twig's default filter treats false as empty and would turn "false" back into true. #}
{% set show_image = show_image is not defined or show_image %}
{% set show_date = show_date is not defined or show_date %}
{% set img = item.header.image ?: (item.media.images|first ? item.media.images|first.filename : null) %}
<a class="card" href="{{ item.url }}">
    {% if show_image and img %}
        <div class="card__media">{{ ui.image(img, item, {alt: '', width: 800, height: 500, placeholder: false, sizes: '(max-width: 640px) 100vw, 33vw'}) }}</div>
    {% endif %}
    <div class="card__body">
        {% if show_date %}<time class="card__meta" datetime="{{ item.date|date('c') }}">{{ item.date|date(config.system.pages.dateformat.short ?: 'M j, Y') }}</time>{% endif %}
        <h3 class="card__title">{{ item.title }}</h3>
        {% set summary = item.header.description ?: item.summary(160)|striptags %}
        {% if summary %}<p class="card__text">{{ summary }}</p>{% endif %}
        <span class="card__footer">{{ 'THEME_MAW_STARTER.READ_MORE'|t }} &rarr;</span>
    </div>
</a>
